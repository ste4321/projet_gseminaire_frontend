# Utilisé par `npm run build` : API en ligne (même backend que l'application de gestion)
REACT_APP_API_URL=https://api.gstf-faliarivo.ovh/api

# Actualités en direct : à renseigner avec la valeur REVERB_APP_KEY du .env du serveur.
# Vide = pas de direct ; le site se met alors à jour toutes les 2 minutes.
REACT_APP_REVERB_KEY=
REACT_APP_REVERB_HOST=api.gstf-faliarivo.ovh
REACT_APP_REVERB_PORT=443
REACT_APP_REVERB_SCHEME=https
